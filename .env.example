# Copy to .env and fill in. Never commit .env.

# --- LLM provider (the agents) ---
# stub = fake model, no key needed. openai_compatible = Groq, Gemini, OpenRouter, Ollama, OpenAI...
LLM_PROVIDER=stub
LLM_BASE_URL=
# In Docker, provide the API key in secrets/llm_api_key.txt (see docs/SECRETS.md).
LLM_MODEL=

# --- policy corpus ---
# auto uses a built FAISS index when present and otherwise warns and uses the demo sample corpus.
CORPUS_BACKEND=auto
LLM_JSON_MODE=true
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_S=0.5
LLM_PRICE_IN_PER_1K=0
LLM_PRICE_OUT_PER_1K=0

# --- stub behaviour ---
STUB_DELAY_S=0
STUB_MODE=normal

# --- circuit breaker and loop bounds ---
CB_FAILURE_THRESHOLD=3
CB_RESET_S=30
MAX_COVERAGE_TURNS=12
MAX_TOOL_CALLS=8
RUN_DEADLINE_S=90
TOOL_TIMEOUT_S=5
MAX_VERIFY_ATTEMPTS=2
ENFORCE_MODIFIER_SEARCH=true

# --- thresholds and routing ---
WEAK_RETRIEVAL_THRESHOLD=0.10
FAST_TRACK_MAX_INR=50000
LATE_REPORT_DAYS=30

# --- prompt versions ---
TRIAGE_PROMPT=triage-v1
COVERAGE_PROMPT=coverage-v2
VERIFIER_PROMPT=verifier-v1

# --- API ---
# local run without Docker: memory + inline. docker-compose overrides these to redis + rq.
STORE_BACKEND=memory
QUEUE_BACKEND=inline
INLINE_WORKERS=2
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MIN=30
MAX_REQUEST_BYTES=65536
RUN_CACHE_TTL_S=600
JOB_TIMEOUT_S=180
RUN_TTL_S=604800
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RUNS_DIR=runs
LOG_LEVEL=INFO

# --- guardrails (L4) ---
INJECTION_THRESHOLD=0.6
TOXICITY_MODEL_THRESHOLD=0.8

# --- circuit breaker state: auto = shared in Redis when STORE_BACKEND=redis (needed: RQ forks a child per job), else in-process
CB_BACKEND=auto

# --- worker metrics (Prometheus scrapes every scaled replica on this port; 0 disables) ---
WORKER_METRICS_PORT=9101
# PROMETHEUS_MULTIPROC_DIR defaults to /tmp/prom_multiproc inside the worker; set it only to move it.

# --- load test / demo scripts (read by scripts/locustfile.py; defaults shown) ---
# LOAD_POLL_TIMEOUT_S=120
# LOAD_POLL_INTERVAL_S=0.5
# LOAD_MALFORMED_PCT=0
# LOAD_DESCRIPTION_MIX=plain

