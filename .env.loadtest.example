# Used only with docker-compose.loadtest.yml. These point at the LOCAL STUB, not a real provider.
# Stub latency per LLM call (declared in docs/SLO.md before measuring): 1.5 s +/- 0.3 s
STUB_LLM_DELAY_S=1.5
STUB_LLM_JITTER_S=0.3
LOADTEST_LLM_BASE_URL=http://llm-stub:9000/v1
LOADTEST_LLM_MODEL=stub-model
LOADTEST_RATE_LIMIT_PER_MIN=0
# Reference prices so cost is non-zero in the report. ASSUMPTION: a small hosted model's list price, USD per 1k tokens.
# Replace with your provider's real prices before quoting any cost figure (see docs/COST.md).
LLM_PRICE_IN_PER_1K=0.00015
LLM_PRICE_OUT_PER_1K=0.0006
